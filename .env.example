# Copy to .env and fill in. Wrap a value in single quotes if it contains spaces, # or $.

# Email and password of the TP-Link/Tapo account the plug is registered to
TAPO_USERNAME=you@example.com
TAPO_PASSWORD=
# The plug's LAN IP address (give it a DHCP reservation so it doesn't change)
TAPO_HOST=192.168.1.50

# From https://pushover.net: your user key, and an application's API token
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Optional tuning (these are the defaults)
# DRYER_THRESHOLD_W=10
# DRYER_IDLE_TIME_S=60
# DRYER_POLL_INTERVAL_S=10
